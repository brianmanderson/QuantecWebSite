# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata

# Sass
.sass-cache/

# Ruby
.bundle/
vendor/bundle/

# Word documents. Working notes and briefs belong in docs/ as markdown — see
# docs/site-plan.md and docs/update-requests.md. Both source briefs stay on disk locally but
# out of git; their content and images are already converted under docs/.
*.docx

# Downloaded papers. These are paywalled, copyrighted journal PDFs — they stay on disk for
# local reference and must never reach the public repository. docs/ itself IS tracked (the
# markdown briefs live there); only this subfolder is ignored.
docs/papers/*
!docs/papers/README.md
!docs/papers/download-list.md

# Claude Code machine-local settings (tracked: .claude/settings.json, launch.json, skills/)
.claude/settings.local.json
