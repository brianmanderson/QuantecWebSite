# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata

# Sass
.sass-cache/

# Ruby
.bundle/
vendor/bundle/

# Word documents. Working notes and briefs belong in docs/ as markdown — see
# docs/site-plan.md and docs/update-requests.md. "Website design.docx" predates this rule and
# is still tracked; git ignores .gitignore for already-tracked files.
*.docx

# Claude Code machine-local settings (tracked: .claude/settings.json, launch.json, skills/)
.claude/settings.local.json
